```{r}
# Production shooter_id encoding 
shooter_stats_full <- train_df %>%
  group_by(shooter_id) %>%
  summarise(n = n(), rate = mean(outcome), .groups = "drop") %>%
  mutate(shrunk_rate = (n * rate + smoothing_k * global_mean) / (n + smoothing_k))
shooter_lookup_full <- setNames(shooter_stats_full$shrunk_rate, shooter_stats_full$shooter_id)

train_df$shooter_id_enc_prod <- shooter_lookup_full[train_df$shooter_id]
stopifnot(!any(is.na(train_df$shooter_id_enc_prod)))


shottype_levels <- levels(factor(train_df$shottype))

feat_cols_prod <- c("distance", "closestdefdist", "shotclock", "shooterspeed",
                     "num_contesters", "dribblesbefore", "shooter_id_enc_prod",
                     "shottype_code")

# Picking nrounds via a held-out validation slice (10%)

set.seed(42)
val_idx <- sample(seq_len(nrow(train_df)), size = floor(0.1 * nrow(train_df)))

dsub <- xgb.DMatrix(data = as.matrix(train_df[-val_idx, feat_cols_prod]),
                     label = train_df$outcome[-val_idx])
dval <- xgb.DMatrix(data = as.matrix(train_df[val_idx, feat_cols_prod]),
                     label = train_df$outcome[val_idx])

fit_for_nrounds <- xgb.train(
  params = params,   
  data = dsub,
  nrounds = 1000,
  watchlist = list(val = dval),
  early_stopping_rounds = 20,
  verbose = 0
)

best_nrounds <- fit_for_nrounds$best_iteration
if (is.null(best_nrounds) || length(best_nrounds) == 0) {
  best_nrounds <- xgb.attr(fit_for_nrounds, "best_iteration")
}
if (is.null(best_nrounds) || length(best_nrounds) == 0) {
  best_nrounds <- fit_for_nrounds$niter  # total rounds actually run, last resort
}
best_nrounds <- as.integer(best_nrounds)

stopifnot(!is.null(best_nrounds), length(best_nrounds) == 1, !is.na(best_nrounds), best_nrounds > 0)

cat("Best nrounds:", best_nrounds, "\n")

# refit on ALL training data using best_nrounds
dfull <- xgb.DMatrix(data = as.matrix(train_df[, feat_cols_prod]),
                      label = train_df$outcome)

model_prod <- xgb.train(
  params = params,
  data = dfull,
  nrounds = best_nrounds,
  verbose = 0
)


test_df <- read_csv("testing.csv.gz", show_col_types = FALSE)

test_df$shooter_id_enc_prod <- shooter_lookup_full[test_df$shooter_id]
n_unseen <- sum(is.na(test_df$shooter_id_enc_prod))
cat("Test rows with a shooter_id unseen in training:", n_unseen,
    sprintf("(%.2f%%) -- filled with global mean make rate (%.4f)\n",
            100 * n_unseen / nrow(test_df), global_mean))
test_df$shooter_id_enc_prod[is.na(test_df$shooter_id_enc_prod)] <- global_mean
stopifnot(!any(is.na(test_df$shooter_id_enc_prod)))

test_df$shottype_code <- match(test_df$shottype, shottype_levels) - 1
stopifnot(!any(is.na(test_df$shottype_code)))

dtest <- xgb.DMatrix(data = as.matrix(test_df[, feat_cols_prod]))
test_df$make_prob <- predict(model_prod, dtest)

submission <- test_df %>% select(shot_id, make_prob)
stopifnot(nrow(submission) == nrow(test_df))
stopifnot(!any(is.na(submission$make_prob)))

cat("\nPredicted make_prob summary:\n")
print(summary(submission$make_prob))

downloads_path <- file.path(Sys.getenv("USERPROFILE"), "Downloads", "submission.csv")
write_csv(submission, downloads_path)
cat("\nsubmission.csv written to:", downloads_path, "\n")
cat("Rows written:", nrow(submission), "\n")
