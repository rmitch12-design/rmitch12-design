```{r}
# Smoothing shooter_id for players with a low number of shot attempts
set.seed(42)
K <- 5
train_df <- train_df %>% mutate(fold = sample(rep(1:K, length.out = n())))

global_mean <- mean(train_df$outcome)

# Smoothing constant: how many "prior" pseudo-shots at the global
# mean we blend in. Higher = more shrinkage toward league average,
# safer for low-volume levels.

smoothing_k <- 20

# Generic out-of-fold shrinkage encoder
oof_target_encode <- function(df, id_col, smoothing_k) {
  encoded <- rep(NA_real_, nrow(df))
  for (k in 1:K) {
    train_idx <- df$fold != k
    test_idx  <- df$fold == k

    stats <- df[train_idx, ] %>%
      group_by(.data[[id_col]]) %>%
      summarise(n = n(), rate = mean(outcome), .groups = "drop") %>%
      mutate(shrunk_rate = (n * rate + smoothing_k * global_mean) / (n + smoothing_k))

    lookup <- setNames(stats$shrunk_rate, stats[[id_col]])

    ids_test <- df[[id_col]][test_idx]
    vals <- lookup[ids_test]
    # ids that never appeared in this folds's training data set to global mean
    vals[is.na(vals)] <- global_mean
    encoded[test_idx] <- vals
  }
  encoded
}

id_cols <- c("shooter_id", "closestdef_id", "off_team_id", "def_team_id")

for (col in id_cols) {
  new_col <- paste0(col, "_enc")
  train_df[[new_col]] <- oof_target_encode(train_df, col, smoothing_k)
}

# Pseudo-R2 for the encoded (out-of-fold) versions
null_dev <- glm(outcome ~ 1, data = train_df, family = binomial())$deviance

encoded_screen <- map_dfr(id_cols, function(col) {
  enc_col <- paste0(col, "_enc")
  fit <- glm(as.formula(paste("outcome ~", enc_col)),
             data = train_df, family = binomial())
  tibble(
    variable  = enc_col,
    n_levels_original = n_distinct(train_df[[col]]),
    pseudo_r2 = 1 - (fit$deviance / null_dev)
  )
}) %>% arrange(desc(pseudo_r2))

print(encoded_screen, n = Inf)

saveRDS(train_df, "train_encoded.rds")
