```{r}
# testing interaction terms
base_formula <- outcome ~ shottype + distance + closestdefdist + shotclock +
  shooterspeed + num_contesters + dribblesbefore + shooter_id_enc
 
candidate_terms <- c(
  "shottype:distance",
  "shottype:closestdefdist",
  "num_contesters:distance",
  "shottype:shooterspeed",
  "gamestate:shotclock",
  "three:closestdefdist",
  "shottype:shotclock",
  "dribblesbefore:shotclock"
)
 
# since gamestate/three aren't in the base formula
needs_gamestate <- c("gamestate:shotclock")
needs_three     <- c("three:closestdefdist")
 
model_base <- glm(base_formula, data = train_df, family = binomial())
aic_base <- AIC(model_base)
bic_base <- BIC(model_base)
 
log_loss <- function(y, p) {
  p <- pmin(pmax(p, 1e-12), 1 - 1e-12)
  -mean(y * log(p) + (1 - y) * log(1 - p))
}
 
cv_log_loss <- function(formula, data, folds, K) {
  losses <- numeric(K)
  for (k in 1:K) {
    train_fold <- data[folds != k, ]
    test_fold  <- data[folds == k, ]
    fit <- glm(formula, data = train_fold, family = binomial())
    p <- predict(fit, newdata = test_fold, type = "response")
    losses[k] <- log_loss(test_fold$outcome, p)
  }
  mean(losses)
}
 
cv_ll_base <- cv_log_loss(base_formula, train_df, train_df$fold, K)
 
results <- map_dfr(candidate_terms, function(term) {
  extra_main <- character(0)
  if (term %in% needs_gamestate) extra_main <- c(extra_main, "gamestate")
  if (term %in% needs_three)     extra_main <- c(extra_main, "three")
 
  rhs <- paste(c(
    "shottype", "distance", "closestdefdist", "shotclock",
    "shooterspeed", "num_contesters", "dribblesbefore", "shooter_id_enc",
    extra_main, term
  ), collapse = " + ")
  form <- as.formula(paste("outcome ~", rhs))
 
  fit_full <- glm(form, data = train_df, family = binomial())
  extra_params <- length(coef(fit_full)) - length(coef(model_base))
  cv_ll_term <- cv_log_loss(form, train_df, train_df$fold, K)
 
  tibble(
    term              = term,
    extra_params      = extra_params,
    aic_delta         = aic_base - AIC(fit_full),   
    bic_delta         = bic_base - BIC(fit_full),  
    cv_logloss_delta  = cv_ll_base - cv_ll_term
  )
}) %>%
  arrange(desc(cv_logloss_delta))
 
print(results, n = Inf)
write_csv(results, "interaction_term_comparison.csv")
