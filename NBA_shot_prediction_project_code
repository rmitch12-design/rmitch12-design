```{r}
# Gradient Boosted Tree Model 

train_df$shottype_code <- as.integer(factor(train_df$shottype)) - 1  

feat_cols <- c("distance", "closestdefdist", "shotclock", "shooterspeed",
               "num_contesters", "dribblesbefore", "shooter_id_enc",
               "shottype_code")
 
X <- as.matrix(train_df[, feat_cols])
y <- train_df$outcome
 
log_loss <- function(y, p) {
  p <- pmin(pmax(p, 1e-12), 1 - 1e-12)
  -mean(y * log(p) + (1 - y) * log(1 - p))
}
 
params <- list(
  objective = "binary:logistic",
  eval_metric = "logloss",
  max_depth = 6,
  eta = 0.05,               
  subsample = 0.8,
  colsample_bytree = 0.8
)
 
cv_losses <- numeric(K)
models <- vector("list", K)
 
for (k in 1:K) {
  train_idx <- train_df$fold != k
  test_idx  <- train_df$fold == k
 
  dtrain <- xgb.DMatrix(data = X[train_idx, ], label = y[train_idx])
  dtest  <- xgb.DMatrix(data = X[test_idx, ], label = y[test_idx])
 
  fit <- xgb.train(
    params = params,
    data = dtrain,
    nrounds = 500,
    watchlist = list(val = dtest),
    early_stopping_rounds = 20,
    verbose = 0
  )
 
  p <- predict(fit, dtest)
  cv_losses[k] <- log_loss(y[test_idx], p)
  models[[k]] <- fit
 
  cat("Fold", k, "-- best iteration:", fit$best_iteration,
      " log-loss:", round(cv_losses[k], 5), "\n")
}
 
cat("\n XGBoost CV results \n")
cat("Per-fold log-loss:", round(cv_losses, 5), "\n")
cat("Mean CV log-loss:", mean(cv_losses), " (sd:", sd(cv_losses), ")\n")
 
importance <- xgb.importance(feature_names = feat_cols, model = models[[1]])
cat("\n Feature importance \n")
print(importance)
 
