# Turn closestdefapproach into 4 numeric columns
# Format: "{dist_at_1.0s, dist_at_0.75s, dist_at_0.5s, dist_at_0.25s}"

new_approach <- train_df$closestdefapproach %>%
  str_remove_all("[{}]") %>%
  str_split_fixed(",", 4) %>%
  apply(2, as.numeric)
colnames(new_approach) <- c("def_dist_1_0s", "def_dist_0_75s",
                                "def_dist_0_5s", "def_dist_0_25s")

train_df <- bind_cols(train_df, as_tibble(new_approach)) %>%
  mutate(closeout_speed = (def_dist_1_0s - closestdefdist) / 1.0)

# Variable list

continuous_vars <- c(
  "distance", "locationx", "locationy", "dribblesbefore",
  "shotclock", "closestdefdist", "shooterspeed",
  "def_dist_1_0s", "def_dist_0_75s", "def_dist_0_5s", "def_dist_0_25s",
  "closeout_speed", "num_contesters", "distcont1"
)

categorical_vars <- c(
  "season_id", "month", "gamestate", "shottype", "three", "contested"
)

all_vars <- c(continuous_vars, categorical_vars)
is_categorical <- all_vars %in% categorical_vars

null_deviance_for <- function(y) {
  glm(y ~ 1, family = binomial())$deviance
}

# Pseudo-R2 loop
pseudo_r2_table <- map2_dfr(all_vars, is_categorical, function(v, cat) {
  d <- train_df %>% filter(!is.na(.data[[v]]))

  form <- if (cat) {
    as.formula(paste0("outcome ~ factor(", v, ")"))
  } else {
    as.formula(paste0("outcome ~ ", v))
  }

  fit <- glm(form, data = d, family = binomial())
  nd  <- null_deviance_for(d$outcome)

  tibble(
    variable    = v,
    type        = if (cat) "categorical" else "continuous",
    n_obs       = nrow(d),
    n_levels    = if (cat) n_distinct(d[[v]]) else NA_integer_,
    deviance    = fit$deviance,
    null_dev    = nd,
    pseudo_r2   = 1 - (fit$deviance / nd),
    aic         = fit$aic
  )
}) %>%
  arrange(desc(pseudo_r2))

print(pseudo_r2_table, n = Inf)

write_csv(pseudo_r2_table, "pseudo_r2_all_vars.csv")
