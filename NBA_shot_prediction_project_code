  shooterspeed + num_contesters + dribblesbefore + shooter_id_enc +
  shottype:distance + shottype:closestdefdist + num_contesters:distance
 
model_final <- glm(final_formula, data = train_df, family = binomial())
 
cat(" Final model summary \n")
print(summary(model_final))
 
cat("\nAIC:", AIC(model_final), "\n")
cat("BIC:", BIC(model_final), "\n")

# In sample log loss
log_loss <- function(y, p) {
  p <- pmin(pmax(p, 1e-12), 1 - 1e-12)
  -mean(y * log(p) + (1 - y) * log(1 - p))
}
 
p_insample <- predict(model_final, type = "response")
insample_ll <- log_loss(train_df$outcome, p_insample)
cat("\nIn-sample log-loss:", insample_ll, "\n")

# CV log loss
cv_log_loss <- function(formula, data, folds, K) {
  losses <- numeric(K)
  for (k in 1:K) {
    fit <- glm(formula, data = data[folds != k, ], family = binomial())
    p <- predict(fit, newdata = data[folds == k, ], type = "response")
    losses[k] <- log_loss(data$outcome[folds == k], p)
  }
  losses
}
 
cv_losses <- cv_log_loss(final_formula, train_df, train_df$fold, K)
cat("Mean CV log-loss:", mean(cv_losses), " (sd:", sd(cv_losses), ")\n")
cat("In-sample vs. CV gap:", insample_ll - mean(cv_losses))
